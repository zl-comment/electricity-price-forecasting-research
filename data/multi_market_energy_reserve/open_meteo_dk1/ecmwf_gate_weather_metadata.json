{
  "dataset": "ECMWF IFS gate-available weather for DK1",
  "provider": "Open-Meteo Single Runs API",
  "upstream_model": "ECMWF IFS HRES",
  "documentation": "https://open-meteo.com/en/docs/single-runs-api",
  "api_endpoint": "https://single-runs-api.open-meteo.com/v1/forecast",
  "model_parameter": "ecmwf_ifs",
  "start_delivery_day": "2025-10-01",
  "end_delivery_day": "2026-08-28",
  "civil_timezone": "Europe/Copenhagen",
  "maximum_assumed_publication_latency_hours": 6,
  "grid": [
